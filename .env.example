# Copia in .env.local e compila. NON committare mai .env.local.

# Convex (generate da `npx convex dev`)
NEXT_PUBLIC_CONVEX_URL=
CONVEX_DEPLOYMENT=

# URL pubblico del portale (usato nei link magici)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# NOTA: le variabili NEXT_PUBLIC_* sono incorporate nel codice durante la build:
# vanno presenti prima di `npm run build` (su Vercel: Project Settings > Environment Variables).
# Le variabili del backend (ADMIN_EMAILS, RESEND_API_KEY, AUTH_EMAIL_FROM, JWT_PRIVATE_KEY, JWKS, SITE_URL)
# NON vanno qui: si impostano su Convex. Vedi docs/SETUP.md.
